# --- Модель (LM Studio, OpenAI-совместимый сервер) ---
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=lm-studio
# id загруженной чат-модели: curl http://localhost:1234/v1/models
LLM_MODEL=qwen3-14b
# Служебная (дешёвая) модель: проверка, судья, детектор инъекций. Не задана — как LLM_MODEL
# LLM_MODEL_LIGHT=qwen3-14b
# Цены, ₽ за 1 млн токенов. Условные: локальная модель бесплатна
# LLM_PRICE_MAIN_INPUT=15
# LLM_PRICE_MAIN_OUTPUT=60
# LLM_PRICE_LIGHT_INPUT=3
# LLM_PRICE_LIGHT_OUTPUT=12

# --- База и движок процессов (docker compose) ---
# Если порт 5432 занят локальным PostgreSQL: PG_PORT=5433 и порт в DATABASE_URL тоже 5433
# PG_PORT=5432
DATABASE_URL=postgresql://card:card@localhost:5432/card
TEMPORAL_HOST=localhost:7233
TEMPORAL_TASK_QUEUE=card-queue

# --- Необязательно: пороги и размеры (значения по умолчанию в app/core/config.py) ---
# CONFIDENCE_THRESHOLD=0.6      ниже — карточку проверяет человек
# SEARCH_MIN_SCORE=0.805        порог косинусной близости для открытого поиска
# INJECTION_MAX_SUSPICIOUS=3    столько подозрительных фрагментов — документ к человеку
# MAX_UPLOAD_MB=10
